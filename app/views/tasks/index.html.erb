<h1>タスク一覧</h1>

<%= link_to '新規作成', new_task_path %>
<hr>

<% @tasks.each do |task| %>
  <div>
    <h3><%= task.title %></h3>
    <p>期限: <%= task.deadline %></p>
    <div style="display: flex; gap: 10px; margin-bottom: 10px;">
      <%= button_to '詳細', task, method: :get %>
      <%= button_to '編集', edit_task_path(task), method: :get %>
      <%= button_to '削除', task, method: :delete, data: { turbo_confirm: '本当に削除しますか？' } %>
    </div>
  </div>
  <hr>
<% end %>